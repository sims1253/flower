# Non-secret defaults for Vast.ai automation. Do not put API keys in this file.
VAST_MAX_PRICE=0.20
VAST_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel
VAST_DISK_GB=40
VAST_REMOTE_DIR=/workspace/flower
VAST_RUN_DIR=runs/vast
VAST_PYTHON_FALLBACK=3.12
# Cheap good-enough single-GPU offers, capped by VAST_MAX_PRICE.
VAST_QUERY="verified=true rentable=true rented=false gpu_ram>=16 num_gpus=1 inet_down>=100 inet_up>=20 dph<=${VAST_MAX_PRICE}"
