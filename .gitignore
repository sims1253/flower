# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Run outputs and artifacts
runs/
runs_*.log
reports/
data_cache/
.pytest_cache/
.ruff_cache/
.claude/
.codex
.zcode/

# Profiler output (regenerable via scripts/profile_step.py + analyze_profile.py).
# The Chrome traces are 150-500MB each; the raw log + summary.json are machine-
# specific. Keep the docs/profiling/*.md writeups tracked, ignore everything
# under traces/ and the throwaway run log.
docs/profiling/traces/
docs/profiling/run.log

# Model weights / large checkpoints
*.pt
*.pth
*.ckpt
*.safetensors

# Tokenizers are regenerable via scripts/train_custom_tokenizer.py and
# scripts/compare_tokenizer_algorithms.py (see tokenizers/README.md).
tokenizers/*.json
tokenizers/algo/

# ZCode / agent scratch
.t3/

# Environment / secrets
.env
*.key

# IDE
.idea/
.vscode/
*.swp
